# Optional API configuration for local runs.
# Copy to .env and fill in values locally. Do not commit .env.

# OpenAlex can be used without a key for many workflows. If you have a key,
# keep it local and provide it through the environment.
OPENALEX_API_KEY=

# CORE is optional and only used as one PDF/open-access fallback.
CORE_API_KEY=

# Unpaywall asks for an email parameter. Use a real contact email for
# responsible API use in production runs.
UNPAYWALL_EMAIL=

